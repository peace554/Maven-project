pipeline {
    agent any
    tools {
        maven 'Maven-3.9' // Make sure 'Maven' matches the name in your Global Tool Configuration
        jdk 'JDK-21'
    }
    stages {
        stage('Checkout') {
            steps {
                // This pulls your specific branch
                git branch: 'JUnit-Test', url: 'https://github.com/peace554/Maven-project.git'
            }
        }
        stage('Build') {
            steps {
                dir('Task2-BorderLayout') {
                    bat 'mvn clean compile'
                }
            }
        }
        stage('Test') {
            steps {
                dir('Task2-BorderLayout') {
                    bat 'mvn test'
                }
            }
        }
        stage('Code Quality (SonarQube)') {
            steps {
                dir('Task2-BorderLayout') {
                    // Replace 'MySonarServer' with the Name from Manage Jenkins > System > SonarQube servers
                    withSonarQubeEnv('SonarQube') {
                        bat 'mvn sonar:sonar'
                    }
                }
            }
        }
        stage('Deploy to Staging') {
            steps {
                echo 'All checks passed. Deploying to staging...'
                dir('Task2-BorderLayout') {
                    bat 'mvn package -DskipTests'
                    // Add your specific deployment commands here (e.g., copying files)
                }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline failed. Deployment skipped.'
        }
    }
}
